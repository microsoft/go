{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "shortTitle": { "type": "string" },
        "columnHeader": { "type": "string" },
        "packages": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/item" } },
        "subsections": {
          "type": "array",
          "items": { "$ref": "#/definitions/section" }
        },
        "footnotes": { "type": "array", "items": { "type": "string" } },
        "footer": { "type": "string" }
      },
      "required": ["title"]
    },
    "item": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "minGoVersion": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "platforms": {
          "type": "object",
          "properties": {
            "windows": { "$ref": "#/definitions/platformStatus" },
            "linux": { "$ref": "#/definitions/platformStatus" },
            "macos": { "$ref": "#/definitions/platformStatus" }
          }
        }
      },
      "required": ["name"]
    },
    "platformStatus": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "string",
          "enum": ["false", "warn", "N/A"]
        },
        "minGoVersion": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
