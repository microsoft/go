+func TestVerifyDistrustedSPKI(t *testing.T) {
+	var chain []*Certificate
+	for _, certPEM := range []string{googleLeaf, gtsIntermediate, gtsRoot} {
+		cert, err := certificateFromPEM(certPEM)
+		if err != nil {
+			t.Fatal(err)
+		}
+		chain = append(chain, cert)
+	}
+
+	opts := VerifyOptions{
+		Roots:         NewCertPool(),
+		Intermediates: NewCertPool(),
+		CurrentTime:   time.Unix(1677615892, 0),
+		DNSName:       "www.google.com",
+	}
+	opts.Roots.AddCert(chain[2])
+	opts.Intermediates.AddCert(chain[1])
+
+	for _, verifier := range []string{"Go", "System"} {
+		for _, usage := range []struct {
+			name      string
+			keyUsages []ExtKeyUsage
+		}{
+			{"Default", nil},
+			{"Any", []ExtKeyUsage{ExtKeyUsageAny}},
+		} {
+			t.Run(verifier+"/"+usage.name, func(t *testing.T) {
+				opts := opts
+				opts.KeyUsages = usage.keyUsages
+				if verifier == "System" {
+					if runtime.GOOS != "windows" {
+						t.Skipf("skipping verify test using system APIs on %q", runtime.GOOS)
+					}
+					opts.Roots = nil
+				}
+				if chains, err := chain[0].Verify(opts); err != nil || len(chains) == 0 {
+					t.Fatalf("verification before distrust: chains = %v, err = %v", chains, err)
+				}
+
+				for i, cert := range chain {
+					t.Run([]string{"Leaf", "Intermediate", "Root"}[i], func(t *testing.T) {
+						h := sha256.Sum256(cert.RawSubjectPublicKeyInfo)
+						hash := hex.EncodeToString(h[:])
+						distrustedSPKIHashes[hash] = struct{}{}
+						t.Cleanup(func() { delete(distrustedSPKIHashes, hash) })
+
+						chains, err := chain[0].Verify(opts)
+						if invalid, ok := err.(CertificateInvalidError); !ok || invalid.Reason != NoValidChains {
+							t.Fatalf("expected NoValidChains, got %v", err)
+						}
+						if chains != nil {
+							t.Errorf("expected no chains, got %v", chains)
+						}
+					})
+				}
+			})
+		}
+	}
+}
+
+func TestVerifyDistrustedSPKIAlternateChain(t *testing.T) {
+	roots, intermediates, leaf := buildTrustGraph(t, trustGraphDescription{
+		Roots: []rootDescription{{Subject: "root1"}, {Subject: "root2"}},
+		Leaf:  "leaf",
+		Graph: []trustGraphEdge{
+			{Issuer: "root1", Subject: "intermediate", Type: intermediateCertificate},
+			{Issuer: "root2", Subject: "intermediate", Type: intermediateCertificate},
+			{Issuer: "intermediate", Subject: "leaf", Type: leafCertificate},
+		},
+	})
+	opts := VerifyOptions{Roots: roots, Intermediates: intermediates}
+	chains, err := leaf.Verify(opts)
+	if err != nil || len(chains) != 2 {
+		t.Fatalf("expected two chains before distrust, got %v, %v", chains, err)
+	}
+	want := chainsToStrings(chains[1:])
+	h := sha256.Sum256(chains[0][len(chains[0])-1].RawSubjectPublicKeyInfo)
+	hash := hex.EncodeToString(h[:])
+	distrustedSPKIHashes[hash] = struct{}{}
+	t.Cleanup(func() { delete(distrustedSPKIHashes, hash) })
+
+	for _, keyUsages := range [][]ExtKeyUsage{nil, {ExtKeyUsageAny}} {
+		opts.KeyUsages = keyUsages
+		chains, err := leaf.Verify(opts)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := chainsToStrings(chains); !slices.Equal(got, want) {
+			t.Errorf("unexpected chains: got %v, want %v", got, want)
+		}
+	}
+}
