Subject: [PATCH] Skip failing tests on Windows

---
 src/cmd/cgo/internal/test/test.go                | 3 +++
 src/cmd/cgo/internal/testsanitizers/asan_test.go | 1 +
 2 files changed, 4 insertions(+)

diff --git a/src/cmd/cgo/internal/test/test.go b/src/cmd/cgo/internal/test/test.go
index 844b2dd42c8cbf..9e73c1feaed003 100644
--- a/src/cmd/cgo/internal/test/test.go
+++ b/src/cmd/cgo/internal/test/test.go
@@ -1096,6 +1096,9 @@ func testErrno(t *testing.T) {
 }
 
 func testMultipleAssign(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("fails with internal linking: https://github.com/microsoft/go/issues/1059")
+	}
 	p := C.CString("234")
 	n, m := C.strtol(p, nil, 345), C.strtol(p, nil, 10)
 	defer C.free(unsafe.Pointer(p))
diff --git a/src/cmd/cgo/internal/testsanitizers/asan_test.go b/src/cmd/cgo/internal/testsanitizers/asan_test.go
index c2cdf7b6d645e8..575da5149d9c7b 100644
--- a/src/cmd/cgo/internal/testsanitizers/asan_test.go
+++ b/src/cmd/cgo/internal/testsanitizers/asan_test.go
@@ -108,6 +108,7 @@ func TestASANLinkerX(t *testing.T) {
 
 // Issue 66966.
 func TestASANFuzz(t *testing.T) {
+	t.Skip("Test is flaky, see https://github.com/golang/go/issues/73979")
 	config := mustHaveASAN(t)
 
 	t.Parallel()
