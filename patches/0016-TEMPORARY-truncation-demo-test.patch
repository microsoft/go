+package truncationdemo
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// TestTruncationDemo is a deliberately failing test that produces more than 16000
+// characters of output. This exists to verify that the AzDO test viewer displays
+// the truncation notice from json2junit. Delete this test after verifying.
+func TestTruncationDemo(t *testing.T) {
+	t.Log("=== This test deliberately fails to demonstrate AzDO truncation ===")
+	t.Log("")
+	for i := 0; i < 100; i++ {
+		t.Logf("output line %03d: %s", i, strings.Repeat("abcdefgh", 5))
+	}
+	t.Log("")
+	// Use fmt.Println so the env var lines appear without the "file:line:" prefix,
+	// allowing json2junit's env var shortening to recognize them.
+	fmt.Println("PATH=" + strings.Repeat("/usr/local/very/long/path:", 20) + "/final/bin")
+	fmt.Println("GOPATH=" + strings.Repeat("/home/user/go/path/segment:", 10) + "/home/runner/go")
+	t.Log("")
+	for i := 100; i < 200; i++ {
+		t.Logf("output line %03d: %s", i, strings.Repeat("abcdefgh", 5))
+	}
+	t.Fatal("Deliberate failure to demonstrate truncation in AzDO test viewer. Delete patch 0016 after verifying.")
+}
