+func TestMicrosoftMLDSASignatureAlgorithms(t *testing.T) {
+	for _, profile := range []string{"default", "off"} {
+		t.Run(profile, func(t *testing.T) {
+			testenv.SetGODEBUG(t, "ms_tlsprofile="+profile)
+			for _, value := range []string{"", "0", "1"} {
+				t.Run("ms_tlsmldsa="+value, func(t *testing.T) {
+					testenv.SetGODEBUG(t, "ms_tlsmldsa="+value)
+					for _, versions := range []struct {
+						name     string
+						min, max uint16
+					}{
+						{"TLS12", VersionTLS12, VersionTLS12},
+						{"TLS13", VersionTLS13, VersionTLS13},
+						{"TLS12-TLS13", VersionTLS12, VersionTLS13},
+					} {
+						t.Run(versions.name, func(t *testing.T) {
+							wantMLDSA := value != "0" && versions.max == VersionTLS13 && fips140.Version() != "v1.0.0"
+							for name, sigAlgs := range map[string][]SignatureScheme{
+								"signature_algorithms":      supportedSignatureAlgorithms(versions.min, versions.max),
+								"signature_algorithms_cert": supportedSignatureAlgorithmsCert(versions.min, versions.max),
+							} {
+								for _, scheme := range []SignatureScheme{MLDSA44, MLDSA65, MLDSA87} {
+									if got := slices.Contains(sigAlgs, scheme); got != wantMLDSA {
+										t.Errorf("%s contains %v = %v, want %v", name, scheme, got, wantMLDSA)
+									}
+								}
+								if !slices.Contains(sigAlgs, ECDSAWithP256AndSHA256) {
+									t.Errorf("%s is missing ECDSAWithP256AndSHA256", name)
+								}
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestMicrosoftMLDSAHandshake(t *testing.T) {
+	cryptotest.MustMinimumFIPS140ModuleVersion(t, "v1.26.0")
+	enableMicrosoftProfile(t)
+
+	for _, value := range []string{"", "0", "1"} {
+		t.Run("ms_tlsmldsa="+value, func(t *testing.T) {
+			testenv.SetGODEBUG(t, "ms_tlsmldsa="+value)
+			for _, tt := range []struct {
+				scheme         SignatureScheme
+				server, client Certificate
+			}{
+				{MLDSA44, testMLDSA44Cert, testClientMLDSA44Cert},
+				{MLDSA65, testMLDSA65Cert, testClientMLDSA65Cert},
+				{MLDSA87, testMLDSA87Cert, testClientMLDSA87Cert},
+			} {
+				t.Run(tt.scheme.String(), func(t *testing.T) {
+					cert := tt.server
+					cert.SupportedSignatureAlgorithms = []SignatureScheme{tt.scheme}
+					scheme, err := selectSignatureScheme(VersionTLS13, &cert, []SignatureScheme{tt.scheme})
+					if value == "0" {
+						if err == nil || !strings.Contains(err.Error(), "GODEBUG=ms_tlsmldsa=0") {
+							t.Fatalf("selectSignatureScheme error = %v, want ML-DSA disabled error", err)
+						}
+					} else if err != nil || scheme != tt.scheme {
+						t.Fatalf("selectSignatureScheme = %v, %v; want %v, nil", scheme, err, tt.scheme)
+					}
+
+					t.Run("Server", func(t *testing.T) {
+						serverConfig := testConfigServer.Clone()
+						serverConfig.Certificates = []Certificate{cert}
+						serverConfig.MinVersion = VersionTLS13
+						clientConfig := testConfigClient.Clone()
+						_, _, err := testHandshake(t, clientConfig, serverConfig)
+						if (err == nil) != (value != "0") {
+							t.Fatalf("ML-DSA server handshake error = %v, want success = %v", err, value != "0")
+						}
+
+						serverConfig.Certificates = append(serverConfig.Certificates, testECDSAP256Cert)
+						_, cs, err := testHandshake(t, clientConfig, serverConfig)
+						if err != nil {
+							t.Fatalf("handshake with ECDSA fallback: %v", err)
+						}
+						wantScheme := tt.scheme
+						if value == "0" {
+							wantScheme = ECDSAWithP256AndSHA256
+						}
+						if cs.testingOnlyPeerSignatureAlgorithm != wantScheme {
+							t.Errorf("server signature algorithm = %v, want %v", cs.testingOnlyPeerSignatureAlgorithm, wantScheme)
+						}
+					})
+
+					t.Run("Client", func(t *testing.T) {
+						serverConfig := testConfigServer.Clone()
+						serverConfig.Certificates = []Certificate{testECDSAP256Cert}
+						serverConfig.MinVersion = VersionTLS13
+						serverConfig.ClientAuth = RequireAndVerifyClientCert
+						clientConfig := testConfigClient.Clone()
+						clientConfig.Certificates = []Certificate{tt.client}
+						ss, _, err := testHandshake(t, clientConfig, serverConfig)
+						if (err == nil) != (value != "0") {
+							t.Fatalf("ML-DSA client handshake error = %v, want success = %v", err, value != "0")
+						}
+						if err == nil && ss.testingOnlyPeerSignatureAlgorithm != tt.scheme {
+							t.Errorf("client signature algorithm = %v, want %v", ss.testingOnlyPeerSignatureAlgorithm, tt.scheme)
+						}
+					})
+				})
+			}
+		})
+	}
+}
+
 func enableMicrosoftProfile(t *testing.T) {
 	t.Setenv("GODEBUG", strings.ReplaceAll(os.Getenv("GODEBUG"), "ms_tlsprofile=off", "")+",ms_tlsprofile=default")
 }
