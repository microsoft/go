+//go:build goexperiment.systemcrypto && !(cgo || 386 || amd64 || arm || arm64 || loong64 || ppc64le || riscv64 || s390x)
+
+package crypto
+
+func init() {
+	`
+	Using system crypto on Linux requires CGO_ENABLED=1.
+
+	Our cgo-less OpenSSL implementation is only supported on certain architectures.
+	These architectures are: 386, amd64, arm, arm64, loong64, ppc64le, riscv64 and s390x.
