+func SupportsRSAPublicKey(bits int) bool {
+	min := 1024
+	if fips140.Enabled() {
+		// The built-in OpenSSL 3 FIPS provider requires at least 2048 bits for FIPS compliance.
+		min = 2048
+	}
+	return bits >= min && bits%8 == 0 && bits <= 16384
