+// SystemCryptoSupported reports whether goos/goarch supports system crypto.
+func SystemCryptoSupported(goos, goarch string) bool {
+	switch goos {
+	case "linux", "darwin":
+		return true
+	case "windows":
+		return goarch == "amd64" || goarch == "arm64"
+	default:
+		return false
+	}
+}
