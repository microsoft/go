+func TestToolenvMicrosoft(t *testing.T) {
+	for _, tt := range []struct {
+		name, flags, want string
+	}{
+		{"empty", "", "-tags=ms_skipfipscheck"},
+		{"other flags", "-trimpath -ldflags=-w", "-trimpath -ldflags=-w -tags=ms_skipfipscheck"},
+		{"existing tags", "-tags=first,second -trimpath", "-tags=first,second,ms_skipfipscheck -trimpath"},
+		{"repeated tags", "-tags=first -tags=second", "-tags=first,ms_skipfipscheck -tags=second"},
+		{"whitespace", " \t-trimpath  -tags= \t", "-trimpath -tags=,ms_skipfipscheck"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("GOFLAGS", tt.flags)
+			t.Setenv("MS_GO_NOSYSTEMCRYPTO", "0")
+			want := []string{"MS_GO_NOSYSTEMCRYPTO=1", "GOFLAGS=" + tt.want}
+			if got := toolenvMicrosoft(nil); !slices.Equal(got, want) {
+				t.Errorf("inherited environment = %q, want %q", got, want)
+			}
+
+			env := []string{"OTHER=keep", "GOFLAGS=" + tt.flags, "MS_GO_NOSYSTEMCRYPTO=0"}
+			t.Setenv("GOFLAGS", "-tags=ignored")
+			want = []string{"OTHER=keep", "GOFLAGS=" + tt.want, "MS_GO_NOSYSTEMCRYPTO=1"}
+			if got := toolenvMicrosoft(env); !slices.Equal(got, want) {
+				t.Errorf("explicit environment = %q, want %q", got, want)
+			}
+		})
+	}
+}
