+		t.Fatalf("Enabled() = %v, want no systemcrypto", flags.Enabled())
+	}
+	if got := flags.String(); got != "" {
+		t.Fatalf("String() = %q, want empty string", got)
+	}
+
+	if slices.Contains(flags.All(), "systemcrypto") || slices.Contains(flags.All(), "nosystemcrypto") {
+		t.Fatalf("All() = %v, want no systemcrypto setting", flags.All())
+	}
+	for _, exp := range []string{"opensslcrypto", "cngcrypto", "darwincrypto"} {
+		if slices.Contains(flags.All(), exp) || slices.Contains(flags.All(), "no"+exp) {
+			t.Fatalf("All() = %v, want no %s setting", flags.All(), exp)
+		}
+		if _, err := ParseGOEXPERIMENT("windows", "386", exp); err == nil {
+			t.Fatalf("ParseGOEXPERIMENT accepted %s", exp)
+		}
+	}
+	if _, err := ParseGOEXPERIMENT("windows", "386", "systemcrypto"); err == nil {
+		t.Fatal("ParseGOEXPERIMENT accepted systemcrypto")
+	} else if !strings.Contains(err.Error(), "enabled automatically") || !strings.Contains(err.Error(), "MS_GO_NOSYSTEMCRYPTO=1") {
+		t.Fatalf("ParseGOEXPERIMENT systemcrypto error = %q", err)
+	}
+	if _, err := ParseGOEXPERIMENT("windows", "amd64", "nosystemcrypto"); err == nil {
