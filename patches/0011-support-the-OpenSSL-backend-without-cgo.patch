+	if header.magic != _SYMCRYPT_BLOB_MAGIC {
+		return nil, errors.New("invalid blob magic")
+	}
+	if header.size != size {
+		return nil, errors.New("invalid blob size")
+	}
+	if header._type != typ {
+		return nil, errors.New("invalid blob type")
+	}
+
+	buf = append(buf, magic...)
+	switch ch {
+	case crypto.MD5:
