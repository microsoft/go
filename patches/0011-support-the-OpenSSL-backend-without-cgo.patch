+			ossl.RSA_free(key)
+			ossl.EVP_PKEY_free(pkey)
+			return nil, err
+		}
+	case 3:
+		var err error
+		if pkey, err = newRSAKey3(false, n, e, nil, nil, nil, nil, nil, nil); err != nil {
+			return nil, err
+		}
+	default:
+		panic(errUnsupportedVersion())
+	}
