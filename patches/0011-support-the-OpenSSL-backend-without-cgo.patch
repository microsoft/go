+// SupprtHKDF reports whether the current OpenSSL version supports HKDF.
+func SupportsHKDF() bool {
+	switch vMajor {
+	case 1:
+		return versionAtOrAbove(1, 1, 1)
+	case 3:
+		_, err := fetchHKDF3()
+		return err == nil
+	default:
+		panic(errUnsupportedVersion())
+	}
