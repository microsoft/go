+		if err != nil {
+			return nil, err
+		}
+		defer ossl.EVP_KDF_CTX_free(ctx)
+		size, err := ossl.EVP_KDF_CTX_get_kdf_size(ctx)
+		if err != nil {
+			return nil, err
+		}
+		out := make([]byte, size)
+		if _, err := ossl.EVP_KDF_derive(ctx, base(out), len(out), nil); err != nil {
+			return nil, err
+		}
+		return out, nil
+	default:
+		panic(errUnsupportedVersion())
+	}
