+func symCryptHashStateInfo(ch crypto.Hash) (size, typ uint32) {
+	switch ch {
+	case crypto.MD5:
+		return _SYMCRYPT_MD5_STATE_EXPORT_SIZE, _SymCryptBlobTypeMd5State
+	case crypto.SHA1:
+		return _SYMCRYPT_SHA1_STATE_EXPORT_SIZE, _SymCryptBlobTypeSha1State
+	case crypto.SHA224:
