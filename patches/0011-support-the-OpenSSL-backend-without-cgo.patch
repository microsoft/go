+		// if the BNs are NULL and we will free non-NULL BNs in the error handling.
+		bn, _ := bigToBN(n)
+		be, _ := bigToBN(e)
+		if _, err := ossl.RSA_set0_key(key, bn, be, nil); err != nil {
+			ossl.BN_free(bn)
+			ossl.BN_free(be)
+			ossl.RSA_free(key)
+			return nil, err
+		}
+		pkey, err = ossl.EVP_PKEY_new()
+		if err != nil {
+			ossl.RSA_free(key)
+			return nil, err
+		}
