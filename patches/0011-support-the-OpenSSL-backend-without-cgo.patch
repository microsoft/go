+			ossl.EVP_MD_CTX_free(h2.ctx)
+			panic(err)
+		}
+		h2.ctx2, err = ossl.EVP_MD_CTX_new()
+		if err != nil {
+			ossl.EVP_MD_CTX_free(h2.ctx)
