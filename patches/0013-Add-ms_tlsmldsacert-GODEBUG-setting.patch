+func TestMicrosoftSignatureAlgorithmsCert(t *testing.T) {
+	classicalCertSigAlgs := []SignatureScheme{
+		PSSWithSHA256,
+		ECDSAWithP256AndSHA256,
+		Ed25519,
+		PSSWithSHA384,
+		PSSWithSHA512,
+		PKCS1WithSHA256,
+		PKCS1WithSHA384,
+		PKCS1WithSHA512,
+		ECDSAWithP384AndSHA384,
+		ECDSAWithP521AndSHA512,
+		PKCS1WithSHA1,
+		ECDSAWithSHA1,
+	}
+	if fips140tls.Required() {
+		classicalCertSigAlgs = slices.DeleteFunc(classicalCertSigAlgs, func(s SignatureScheme) bool {
+			return !slices.Contains(allowedSignatureAlgorithmsFIPS, s)
+		})
+	}
+	check := func(t *testing.T, sigAlgs, certSigAlgs []SignatureScheme, maxVersion uint16, advertiseMLDSA bool) {
+		t.Helper()
+		var wantCertSigAlgs []SignatureScheme
+		for _, s := range []SignatureScheme{MLDSA44, MLDSA65, MLDSA87} {
+			want := maxVersion >= VersionTLS13 && fips140.Version() != "v1.0.0" &&
+				(!fips140tls.Required() || slices.Contains(allowedSignatureAlgorithmsFIPS, s))
+			if got := slices.Contains(sigAlgs, s); got != want {
+				t.Errorf("signature_algorithms contains %v = %v, want %v", s, got, want)
+			}
+			if advertiseMLDSA && want {
+				wantCertSigAlgs = append(wantCertSigAlgs, s)
+			}
+		}
+		wantCertSigAlgs = append(wantCertSigAlgs, classicalCertSigAlgs...)
+		if !slices.Equal(certSigAlgs, wantCertSigAlgs) {
+			t.Errorf("signature_algorithms_cert = %v, want %v", certSigAlgs, wantCertSigAlgs)
+		}
+	}
+
+	for _, value := range []string{"", "0", "1"} {
+		for _, profile := range []string{"default", "off"} {
+			t.Run("ms_tlsmldsacert="+value+"/"+profile, func(t *testing.T) {
+				testenv.SetGODEBUG(t, "ms_tlsmldsacert="+value)
+				testenv.SetGODEBUG(t, "ms_tlsprofile="+profile)
+				for _, versions := range []struct {
+					name     string
+					min, max uint16
+				}{
+					{"TLS12", VersionTLS12, VersionTLS12},
+					{"TLS13", VersionTLS13, VersionTLS13},
+					{"TLS12-TLS13", VersionTLS12, VersionTLS13},
+				} {
+					t.Run("ClientHello/"+versions.name, func(t *testing.T) {
+						config := testConfigClient.Clone()
+						config.MinVersion, config.MaxVersion = versions.min, versions.max
+						hello, _, _, err := Client(nil, config).makeClientHello()
+						if err != nil {
+							t.Fatal(err)
+						}
+						data, err := hello.marshal()
+						if err != nil {
+							t.Fatal(err)
+						}
+						var parsed clientHelloMsg
+						if !parsed.unmarshal(data) {
+							t.Fatal("failed to unmarshal ClientHello")
+						}
+						check(t, parsed.supportedSignatureAlgorithms, parsed.supportedSignatureAlgorithmsCert, versions.max, value != "0")
+					})
+				}
+
+				t.Run("CertificateRequest", func(t *testing.T) {
+					clientConfig := testConfigClient.Clone()
+					clientConfig.MinVersion = VersionTLS13
+					serverConfig := testConfigServer.Clone()
+					serverConfig.MinVersion = VersionTLS13
+					serverConfig.ClientAuth = RequestClientCert
+					serverConfig.SessionTicketsDisabled = true
+					cli := newTestQUICClient(t, &QUICConfig{TLSConfig: clientConfig})
+					cli.conn.SetTransportParameters(nil)
+					srv := newTestQUICServer(t, &QUICConfig{TLSConfig: serverConfig})
+					srv.conn.SetTransportParameters(nil)
+					var data []byte
+					onEvent := func(e QUICEvent, src, dst *testQUICConn) bool {
+						if src == srv && e.Kind == QUICWriteData && e.Level == QUICEncryptionLevelHandshake {
+							data = append(data, e.Data...)
+						}
+						return false
+					}
+					if err := runTestQUICConnection(t.Context(), cli, srv, onEvent); err != nil {
+						t.Fatal(err)
+					}
+					found := false
+					for messages := cryptobyte.String(data); !messages.Empty(); {
+						raw := messages
+						var typ uint8
+						var body cryptobyte.String
+						if !messages.ReadUint8(&typ) || !messages.ReadUint24LengthPrefixed(&body) {
+							t.Fatal("invalid server handshake message")
+						}
+						if typ != typeCertificateRequest {
+							continue
+						}
+						var parsed certificateRequestMsgTLS13
+						if !parsed.unmarshal(raw[:4+len(body)]) {
+							t.Fatal("failed to unmarshal CertificateRequest")
+						}
+						check(t, parsed.supportedSignatureAlgorithms, parsed.supportedSignatureAlgorithmsCert, VersionTLS13, value != "0")
+						found = true
+					}
+					if !found {
+						t.Fatal("server did not send CertificateRequest")
+					}
+				})
+			})
+		}
+	}
+}
+
 func enableMicrosoftProfile(t *testing.T) {
 	t.Setenv("GODEBUG", strings.ReplaceAll(os.Getenv("GODEBUG"), "ms_tlsprofile=off", "")+",ms_tlsprofile=default")
 }
