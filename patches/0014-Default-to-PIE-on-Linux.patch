 // DefaultPIE reports whether goos/goarch produces a PIE binary when using the
-// "default" buildmode. On Windows this is affected by -race,
+// "default" buildmode. On some platforms this is affected by -race,
 // so force the caller to pass that in to centralize that choice.
 func DefaultPIE(goos, goarch string, isRace bool) bool {
 	switch goos {
 	case "android", "ios":
 		return true
+	case "linux":
+		// Preserve race support and builds without an external linker.
+		return !isRace && InternalLinkPIESupported(goos, goarch)
