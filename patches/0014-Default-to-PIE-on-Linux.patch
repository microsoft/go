 	switch goos {
 	case "android", "ios":
 		return true
+	case "linux":
+		// Preserve -race/-asan compatibility and builds without an external linker.
+		return !isRace && !isASan && InternalLinkPIESupported(goos, goarch)
 	case "windows":
 		if isRace {
