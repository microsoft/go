+package azdolimittest
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// TestAzDOCharLimit prints ~30000 characters with markers every 1000 chars
+// to determine exactly where AzDO truncates test failure content.
+func TestAzDOCharLimit(t *testing.T) {
+	var total int
+	for i := 0; i < 30; i++ {
+		marker := fmt.Sprintf("=== MARKER %dk ===", (i + 1))
+		// Each block: marker + padding to reach ~1000 chars
+		padLen := 1000 - len(marker) - 1 // -1 for newline
+		if padLen < 0 {
+			padLen = 0
+		}
+		line := marker + strings.Repeat(".", padLen)
+		fmt.Println(line)
+		total += len(line) + 1
+	}
+	fmt.Printf("=== TOTAL CHARS PRINTED: %d ===\n", total)
+	t.Fatalf("Deliberate failure. Total chars: %d. Find the last visible MARKER to determine AzDO limit. Delete this test after.", total)
+}
