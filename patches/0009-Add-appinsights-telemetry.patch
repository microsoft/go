+		"MS_GOTOOLCHAIN_TELEMETRY_ENDPOINT=" + appInsightsURL,
+		"MS_GOTOOLCHAIN_TELEMETRY_ALLOW_GO_DEVEL=1", // allow telemetry for Go development versions
