+	// Microsoft build of Go patch: this function originally only removed one of
+	// the " X:" or "-X:" suffixes, and it looked for " X:" first. This breaks
+	// the gobootstrap cache salt because our version has both "-X:" and " X:"
+	// suffixes. For example, it fails to remove the "-X:" part in this example:
+	//
+	//  go1.26rc1-1_microsoft-X:nodwarf5,nogreenteagc,norandomizedheapbase64,nosizespecializedmalloc X:nodwarf5,nogreenteagc,norandomizedheapbase64,nosizespecializedmalloc
+	//
+	// We patch this function to remove both without an early exit when one of
+	// the suffixes is found.
+	version, _, _ = strings.Cut(version, " X:")
+	version, _, _ = strings.Cut(version, "-X:")
 	return version
