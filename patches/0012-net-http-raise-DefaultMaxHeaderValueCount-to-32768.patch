diff --git a/src/net/http/serve_test.go b/src/net/http/serve_test.go
index 2d129f69d3575e..35bde670655f19 100644
--- a/src/net/http/serve_test.go
+++ b/src/net/http/serve_test.go
@@ -3382,6 +3382,50 @@ func TestStripPrefixNotModifyRequest(t *testing.T) {
 	}
 }
 
+func TestDefaultMaxHeaderValueCount(t *testing.T) {
+	run(t, testDefaultMaxHeaderValueCount, http3SkippedMode)
+}
+
+func testDefaultMaxHeaderValueCount(t *testing.T, mode testMode) {
+	cst := newClientServerTest(t, mode, HandlerFunc(func(w ResponseWriter, r *Request) {
+		w.WriteHeader(StatusOK)
+	}), optQuietLog)
+
+	for _, tt := range []struct {
+		name       string
+		values     int
+		wantStatus int
+	}{
+		// Identity headers such as Impersonate-Group are sent one value
+		// per header line; large group sets must fit the default.
+		{name: "15000 repeated values", values: 15000, wantStatus: StatusOK},
+		{name: "above default", values: DefaultMaxHeaderValueCount + 1, wantStatus: StatusRequestHeaderFieldsTooLarge},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			req, err := NewRequest("GET", cst.ts.URL, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for range tt.values {
+				req.Header.Add("Impersonate-Group", "group")
+			}
+			res, err := cst.c.Do(req)
+			if err != nil {
+				if mode == http2Mode && tt.wantStatus == StatusRequestHeaderFieldsTooLarge {
+					// As in TestRequestLimit, an HTTP/2 client may reject the
+					// request itself once it has seen the server's SETTINGS.
+					return
+				}
+				t.Fatal(err)
+			}
+			defer res.Body.Close()
+			if res.StatusCode != tt.wantStatus {
+				t.Errorf("got status %d, want %d", res.StatusCode, tt.wantStatus)
+			}
+		})
+	}
+}
+
 func TestRequestLimit(t *testing.T) { run(t, testRequestLimit, http3SkippedMode) }
 func testRequestLimit(t *testing.T, mode testMode) {
 	bytesPerHeader := len("header12345: val12345\r\n")
diff --git a/src/net/http/server.go b/src/net/http/server.go
index aff62f9a8dc595..2480e5c6550216 100644
--- a/src/net/http/server.go
+++ b/src/net/http/server.go
@@ -941,7 +941,14 @@ const DefaultMaxHeaderBytes = 1 << 20 // 1 MB
 // DefaultMaxHeaderValueCount is the maximum permitted number of
 // header values in an HTTP request.
 // This can be overridden by setting [Server.MaxHeaderValueCount].
-const DefaultMaxHeaderValueCount = 500
+//
+// The default leaves room for requests that send one header line per
+// value for large sets, such as Kubernetes impersonation and
+// authenticating-proxy headers that carry one line per group, so that
+// MaxHeaderBytes rather than this count limits them. At 32 bytes per
+// value, it matches DefaultMaxHeaderBytes, still bounding floods of tiny
+// headers.
+const DefaultMaxHeaderValueCount = 32768
 
