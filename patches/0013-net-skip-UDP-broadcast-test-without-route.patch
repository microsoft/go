+<!-- go.dev/issue/79936 -->
+[DefaultMaxHeaderValueCount], the default limit on the number of header values
+a [Server] accepts, is raised from 500 to 32768. Protocols that send one header
+line per value, such as Kubernetes impersonation and request-header
+authentication, exceeded the old limit for identities with many groups.
+Servers that set [Server.MaxHeaderValueCount] are unaffected.
diff --git a/src/net/http/serve_test.go b/src/net/http/serve_test.go
index 24e6d1e1c1267b..a4fe4ecaa6e224 100644
--- a/src/net/http/serve_test.go
+++ b/src/net/http/serve_test.go
@@ -3359,6 +3359,50 @@ func TestStripPrefixNotModifyRequest(t *testing.T) {
 	}
 }
 
+func TestDefaultMaxHeaderValueCount(t *testing.T) {
+	run(t, testDefaultMaxHeaderValueCount, http3SkippedMode)
+}
+
+func testDefaultMaxHeaderValueCount(t *testing.T, mode testMode) {
+	cst := newClientServerTest(t, mode, HandlerFunc(func(w ResponseWriter, r *Request) {
+		w.WriteHeader(StatusOK)
+	}), optQuietLog)
+
+	for _, tt := range []struct {
+		name       string
+		values     int
+		wantStatus int
+	}{
+		// Identity headers such as Impersonate-Group are sent one value
+		// per header line; large group sets must fit the default.
+		{name: "15000 repeated values", values: 15000, wantStatus: StatusOK},
+		{name: "above default", values: DefaultMaxHeaderValueCount + 1, wantStatus: StatusRequestHeaderFieldsTooLarge},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			req, err := NewRequest("GET", cst.ts.URL, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for range tt.values {
+				req.Header.Add("Impersonate-Group", "group")
+			}
+			res, err := cst.c.Do(req)
+			if err != nil {
+				if mode == http2Mode && tt.wantStatus == StatusRequestHeaderFieldsTooLarge {
+					// As in TestRequestLimit, an HTTP/2 client may reject the
+					// request itself once it has seen the server's SETTINGS.
+					return
+				}
+				t.Fatal(err)
+			}
+			defer res.Body.Close()
+			if res.StatusCode != tt.wantStatus {
+				t.Errorf("got status %d, want %d", res.StatusCode, tt.wantStatus)
+			}
+		})
+	}
+}
+
 func TestRequestLimit(t *testing.T) { run(t, testRequestLimit, http3SkippedMode) }
