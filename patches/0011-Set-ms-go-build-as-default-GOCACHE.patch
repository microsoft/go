From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bot-for-go[bot] <199222863+bot-for-go[bot]@users.noreply.github.com>
Date: Thu, 11 Dec 2025 09:06:17 +0100
Subject: [PATCH] Set ms-go-build as default GOCACHE

Use a Microsoft-specific directory for Go build cache to avoid conflicts
with other Go toolchains.
---
 src/cmd/go/internal/cache/default.go       | 2 +-
 src/cmd/go/testdata/script/cache_unix.txt  | 4 ++--
 src/cmd/go/testdata/script/env_changed.txt | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/cmd/go/internal/cache/default.go b/src/cmd/go/internal/cache/default.go
index cc4e0517b4a12d..442d7a5dd634df 100644
--- a/src/cmd/go/internal/cache/default.go
+++ b/src/cmd/go/internal/cache/default.go
@@ -84,7 +84,7 @@ func DefaultDir() (string, bool, error) {
 			defaultDir = "off"
 			defaultDirErr = fmt.Errorf("GOCACHE is not defined and %v", err)
 		} else {
-			defaultDir = filepath.Join(dir, "go-build")
+			defaultDir = filepath.Join(dir, "ms-go-build")
 		}
 
 		newDir := cfg.Getenv("GOCACHE")
diff --git a/src/cmd/go/testdata/script/cache_unix.txt b/src/cmd/go/testdata/script/cache_unix.txt
index e11804d39abebd..a1a088884a174c 100644
--- a/src/cmd/go/testdata/script/cache_unix.txt
+++ b/src/cmd/go/testdata/script/cache_unix.txt
@@ -23,12 +23,12 @@ stdout $WORK'/gocache$'
 # Without GOCACHE, we should prefer XDG_CACHE_HOME over HOME.
 env GOCACHE=
 go env GOCACHE
-stdout $WORK'/xdg/go-build$$'
+stdout $WORK'/xdg/ms-go-build$$'
 
 # With only HOME set, we should use $HOME/.cache.
 env XDG_CACHE_HOME=
 go env GOCACHE
-stdout $WORK'/home/.cache/go-build$'
+stdout $WORK'/home/.cache/ms-go-build$'
 
 # With no guidance from the environment, we must disable the cache, but that
 # should not cause commands that do not write to the cache to fail.
diff --git a/src/cmd/go/testdata/script/env_changed.txt b/src/cmd/go/testdata/script/env_changed.txt
index da9560062704e6..fda4a1354dad82 100644
--- a/src/cmd/go/testdata/script/env_changed.txt
+++ b/src/cmd/go/testdata/script/env_changed.txt
@@ -74,7 +74,7 @@ go env -changed
 ! stdout 'GOTOOLCHAIN=''?local''?'
 
 [GOOS:windows] env LocalAppData=C:\
-[GOOS:windows] env GOCACHE=C:\go-build
+[GOOS:windows] env GOCACHE=C:\ms-go-build
 [GOOS:windows] go env -changed
 [GOOS:windows] ! stdout 'GOCACHE'
 
