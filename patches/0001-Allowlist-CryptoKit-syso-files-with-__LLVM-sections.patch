---
 src/cmd/go/internal/work/security.go      | 23 +++++++++++++++++++
 src/cmd/go/internal/work/security_test.go | 27 +++++++++++++++++++++++
 2 files changed, 50 insertions(+)

diff --git a/src/cmd/go/internal/work/security.go b/src/cmd/go/internal/work/security.go
index 4dc2db6006dedf122a7a70f178f2895e0ed3f621..7cffef20d96bf0002ec806cae15a01d977631e4a 100644
--- a/src/cmd/go/internal/work/security.go
+++ b/src/cmd/go/internal/work/security.go
@@ -31,6 +31,7 @@ package work
 
 import (
 	"bytes"
+	"crypto/sha256"
 	"debug/elf"
 	"debug/macho"
 	"debug/pe"
@@ -698,6 +699,9 @@ func scanLinkerSearchDir(source, rawDir string, checkLibs bool) error {
 // is a valid binary object/archive (or macOS .tbd stub) rather than a GNU ld
 // linker script, and does not contain embedded linker flags (unallowlisted
 // .drectve directives, LC_LINKER_OPTION, or LTO IR sections).
+//
+// Known CryptoKit .syso files are allowed by content hash. They contain __LLVM
+// sections, but are required for systemcrypto.
 func checkLinkerInputFile(source, path string) error {
 	f, err := os.Open(path)
 	if err != nil {
@@ -713,6 +717,25 @@ func checkLinkerInputFile(source, path string) error {
 		return err
 	}
 
+	if source == ".syso" {
+		var wantHash string
+		switch filepath.Base(path) {
+		case "CryptoKit_amd64.syso":
+			wantHash = "9ce6d4fa52377831adf3c6d27d5a73b619257c4c8d87a0f0cad1fd4693d56ef9"
+		case "CryptoKit_arm64.syso":
+			wantHash = "a897fe39f9486c2aaf5bffd372edbc0c47a03608c12f074364780ac4a7020bd8"
+		}
+		if wantHash != "" {
+			h := sha256.New()
+			if _, err := io.Copy(h, io.NewSectionReader(f, 0, fi.Size())); err != nil {
+				return err
+			}
+			if fmt.Sprintf("%x", h.Sum(nil)) == wantHash {
+				return nil
+			}
+		}
+	}
+
 	if strings.HasSuffix(strings.ToLower(path), ".tbd") && source != ".syso" {
 		var hdr [256]byte
 		n, _ := f.Read(hdr[:])
diff --git a/src/cmd/go/internal/work/security_test.go b/src/cmd/go/internal/work/security_test.go
index bc79a7cecb8fe48a63141c25171078080d50fb3b..2ff78505fc493e6de95ad593f14ecb97cf826796 100644
--- a/src/cmd/go/internal/work/security_test.go
+++ b/src/cmd/go/internal/work/security_test.go
@@ -9,6 +9,7 @@ import (
 	"fmt"
 	"os"
 	"path/filepath"
+	"runtime"
 	"strings"
 	"testing"
 
@@ -804,6 +805,32 @@ func TestCheckCompilerFlagsForInternalLink(t *testing.T) {
 	}
 }
 
+func TestCheckLinkerInputFileCryptoKit(t *testing.T) {
+	for _, name := range []string{"CryptoKit_amd64.syso", "CryptoKit_arm64.syso"} {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(runtime.GOROOT(), "src/vendor/github.com/microsoft/go-crypto-darwin/internal/cryptokit", name)
+			if err := checkLinkerInputFile(".syso", path); err != nil {
+				t.Fatalf("allowlisted .syso rejected: %v", err)
+			}
+			if err := checkLinkerInputFile("LDFLAGS", path); err == nil {
+				t.Error("expected error for CryptoKit object used as LDFLAGS")
+			}
+
+			data, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			modified := filepath.Join(t.TempDir(), name)
+			if err := os.WriteFile(modified, append(data, 0), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			if err := checkLinkerInputFile(".syso", modified); err == nil {
+				t.Error("expected error for modified CryptoKit .syso")
+			}
+		})
+	}
+}
+
 func makeTestCOFFSection(secName string, dataBytes []byte) []byte {
 	hdrAndSec := 20 + 40
 	buf := make([]byte, hdrAndSec+len(dataBytes))
