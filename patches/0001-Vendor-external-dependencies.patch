+	MOVD	(3*8)(R12), R3
+_3args:
+	MOVD	(2*8)(R12), R2
+_2args:
+	MOVD	(1*8)(R12), R1
+_1args:
+	MOVD	(0*8)(R12), R0
+_0args:
+
+	BL	(R13)
+
+	// Restore original stack pointer
+	MOVD	R20, RSP
+
+	MOVD	libcArgs+0(FP), R3
+	MOVD	R0, libcCallInfo_r1(R3)	// save r1
+	MOVD	R1, libcCallInfo_r2(R3)	// save r2
+
+    RET
