+	MOV libcCallInfo_n(X5), X10
+	BEQ X10, ZERO, _0args
+	MOV $1, X6
+	BEQ X10, X6, _1args
+	MOV $2, X6
+	BEQ X10, X6, _2args
+	MOV $3, X6
+	BEQ X10, X6, _3args
+	MOV $4, X6
