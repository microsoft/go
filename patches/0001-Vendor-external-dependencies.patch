+})
+
+var supportsMLKEM1024 = sync.OnceValue(func() bool {
+	if !ossl.EVP_KEYMGMT_fetch_Available() {
+		return false
+	}
+	sig, _ := ossl.EVP_KEYMGMT_fetch(nil, _KeyTypeMLKEM1024.ptr(), nil)
+	if sig == nil {
+		return false
+	}
+	ossl.EVP_KEYMGMT_free(sig)
