+	// X7: &args[8]
+	// X8: loop counter, from 0 to (n-8)*8
+	// X9: scratch
+	// X28: copy of X2 (SP)
+	ADDI $-8, X10, X6
+	SLLI $3, X6, X6
+	ADDI $(8*8), X7, X7
+	MOV  ZERO, X8
+	MOV  X2, X28
+
+stackargs:
+	ADD  X8, X7, X9
+	MOV  (X9), X9
+	ADD  X8, X28, X31
+	MOV  X9, (X31)
+	ADDI $8, X8, X8
+	BNE  X8, X6, stackargs
+
