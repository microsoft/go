+func (key *PublicKeyMLDSA) VerifyExternalMu(mu, signature []byte) error {
+	return mldsaVerifyExternalMu(key.params.paramSet, key.bytes[:key.params.publicKeySize], mu, signature, key.params.signatureSize)
