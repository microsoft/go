+
+func mldsaPublicKey(paramSet string, seed, dst []byte) error {
+	hKey, err := importMLDSAPrivateKey(paramSet, seed)
+	if err != nil {
+		return err
+	}
+	defer bcrypt.DestroyKey(hKey)
