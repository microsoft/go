+	MOVD 24(R1), R2
+	MOVD R24, R1
+
+	// Save return values
+	MOVD R3, libcCallInfo_r1(R25)
+	MOVD R4, libcCallInfo_r2(R25)
+
+	// Restore callee-saved registers
+	MOVD 32(R1), R24
+	MOVD 40(R1), R25
+	MOVD 48(R1), R26
+	MOVD 56(R1), R27
+	MOVD 64(R1), R28
+
+	RET
