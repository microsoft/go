+
+type hashAlgorithm struct {
+	handle    bcrypt.ALG_HANDLE
+	id        string
+	size      uint32
+	blockSize uint32
+}
+
+func mustLoadHash(id string, flags bcrypt.AlgorithmProviderFlags) *hashAlgorithm {
+	h, err := loadHash(id, flags)
+	if err != nil {
+		panic(err)
+	}
