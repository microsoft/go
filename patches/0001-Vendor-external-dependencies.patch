+	// Windows x64 syscall ABI: first four integer args in CX, DX, R8, R9
+	// and 32 bytes of shadow space on the stack.
+	ADJSP $32
+	MOVQ  CX, R9
+	MOVQ  DX, R8
+	MOVQ  SI, DX
+	MOVQ  DI, CX
