+	CMPL CX, $0; JE _0args
+	CMPL CX, $1; JE _1args
+	CMPL CX, $2; JE _2args
+	CMPL CX, $3; JE _3args
+	CMPL CX, $4; JE _4args
+
+#ifndef GOOS_windows // Windows does not pass more than 4 args in registers
+	CMPL CX, $5; JE _5args
+	CMPL CX, $6; JE _6args
+
