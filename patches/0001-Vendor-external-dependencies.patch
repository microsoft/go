+func (h *opensslHMAC) Write(p []byte) (int, error) {
+	if len(p) > 0 {
+		switch major() {
+		case 1:
+			ossl.HMAC_Update(h.ctx1.ctx, p)
+		default:
+			ossl.EVP_MAC_update(h.ctx3.ctx, p)
+		}
+	}
