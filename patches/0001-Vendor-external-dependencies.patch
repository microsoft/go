+// hashFuncToMD converts a hash.Hash function to a GOossl.EVP_MD_PTR.
+// See [hashFuncHash] for details on error handling.
+func hashFuncToMD(fn func() hash.Hash) (ossl.EVP_MD_PTR, error) {
+	h, err := hashFuncHash(fn)
+	if err != nil {
