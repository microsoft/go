+func NewDecapsulationKeyMLKEM1024(seed []byte) (DecapsulationKeyMLKEM1024, error) {
+	if len(seed) != seedSizeMLKEM {
+		return DecapsulationKeyMLKEM1024{}, errors.New("mlkem: invalid decapsulation key size")
+	}
