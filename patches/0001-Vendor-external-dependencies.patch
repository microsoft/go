+func newUINT64(v uint64) _UINT64 {
+	var u _UINT64
+	if isBigEndian() {
+		u[0], u[1] = uint32(v>>32), uint32(v)
+	} else {
+		u[0], u[1] = uint32(v), uint32(v>>32)
+	}
+	return u
+}
