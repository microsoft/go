+	var hKey bcrypt.KEY_HANDLE
+	if err := bcrypt.ImportKeyPair(alg.handle, 0, utf16PtrFromString(bcrypt.PQDSA_PUBLIC_BLOB), &hKey, blob, 0); err != nil {
+		return 0, err
+	}
+	return hKey, nil
