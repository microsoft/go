+func NewPublicKeyRSA(n, e BigInt) (*PublicKeyRSA, error) {
+	var pkey ossl.EVP_PKEY_PTR
+	switch major() {
+	case 1:
+		key, err := ossl.RSA_new()
+		if err != nil {
+			return nil, err
+		}
