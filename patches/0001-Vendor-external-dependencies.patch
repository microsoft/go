+	if err != nil {
+		return nil, err
+	}
+	c := &desCipher{kh: kh, alg: bcrypt.DES3_ALGORITHM, key: bytes.Clone(key)}
+	runtime.SetFinalizer(c, (*desCipher).finalize)
+	return c, nil
