+func (c *aesCipher) Decrypt(dst, src []byte) {
+	dst, src = c.validateAndClipInputs(dst, src)
+
+	var ret uint32
+	err := bcrypt.Decrypt(c.kh, src, nil, nil, dst, &ret, 0)
+	if err != nil {
+		panic(err)
+	}
