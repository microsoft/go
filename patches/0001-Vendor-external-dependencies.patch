+
+func (h *hashX) WriteByte(c byte) error {
+	defer runtime.KeepAlive(h)
+	h.init()
+	hashByte(h.ctx, c)
+	return nil
+}
+
+func (h *hashX) Sum(in []byte) []byte {
+	defer runtime.KeepAlive(h)
+	h.init()
+	return hashSum(h.ctx, h.Size(), in)
+}
+
+func (h *hashX) Size() int {
+	return int(h.alg.size)
+}
+
+func (h *hashX) BlockSize() int {
