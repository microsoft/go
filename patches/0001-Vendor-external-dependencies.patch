+	ctx, err := setupEVP(withKey, padding, h, nil, label, saltLen, ch, init)
+	if err != nil {
+		return err
+	}
+	defer ossl.EVP_PKEY_CTX_free(ctx)
+	return verify(ctx, base(sig), len(sig), base(in), len(in))
