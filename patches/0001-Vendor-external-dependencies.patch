+_3args:
+	MOVL	8(BX), AX
+	MOVL	AX, 8(SP)
+_2args:
+	MOVL	4(BX), AX
+	MOVL	AX, 4(SP)
+_1args:
+	MOVL	0(BX), AX
+	MOVL	AX, 0(SP)
+_0args:
+	MOVL	8(BP), DX		// fn pointer from saved location
+	CALL	DX
+	MOVL	BP, SP
