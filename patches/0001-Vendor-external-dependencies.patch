+// _OSSL_SHA256_CTX layout is taken from
+// https://github.com/openssl/openssl/blob/0418e993c717a6863f206feaa40673a261de7395/include/openssl/sha.h#L51.
+type _OSSL_SHA256_CTX struct {
+	h      [8]uint32
