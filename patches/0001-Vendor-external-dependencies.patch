+func setupEVP(withKey withKeyFunc, padding int32,
+	h, mgfHash hash.Hash, label []byte, saltLen int32, ch crypto.Hash,
+	init initFunc) (_ ossl.EVP_PKEY_CTX_PTR, err error) {
