+		pOutput = new(byte)
+		pInput = pOutput
+	} else {
+		if len(plaintext) > 0 {
+			pOutput = &plaintext[0]
+		}
+		if len(ciphertext) > 0 {
+			pInput = &ciphertext[0]
+		}
+	}
+	return _Decrypt(hKey, pInput, uint32(len(ciphertext)), pPaddingInfo, pbIV, pOutput, uint32(len(plaintext)), pcbResult, dwFlags)
