+	mldsa44 = MLDSAParameters{
+		name:          "ML-DSA-44",
+		paramSet:      bcrypt.MLDSA_PARAMETER_SET_44,
+		publicKeySize: publicKeySizeMLDSA44,
+		signatureSize: signatureSizeMLDSA44,
