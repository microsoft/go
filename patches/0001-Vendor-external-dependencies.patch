+var zero byte
+
+// baseNeverEmpty returns the address of the underlying array in b.
+// If b has zero length, it returns a pointer to a zero byte.
+func baseNeverEmpty(b []byte) *byte {
+	if len(b) == 0 {
+		return &zero
