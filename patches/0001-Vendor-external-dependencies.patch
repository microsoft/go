+	MOVD	libcArgs+0(FP), R3
+
+	MOVD	libcCallInfo_args(R3), R12
+	MOVD	libcCallInfo_fn(R3), R13
+	// Do we have more than 8 arguments?
+	MOVD	libcCallInfo_n(R3), R0
+	CMP	$0,	R0; BEQ	_0args
+	CMP	$1,	R0; BEQ	_1args
+	CMP	$2,	R0; BEQ	_2args
+	CMP	$3,	R0; BEQ	_3args
+	CMP	$4,	R0; BEQ	_4args
+	CMP	$5,	R0; BEQ	_5args
+	CMP	$6,	R0; BEQ	_6args
+	CMP	$7,	R0; BEQ	_7args
+	CMP	$8,	R0; BEQ	_8args
