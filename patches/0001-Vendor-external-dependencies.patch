+	// Reserve stack space for remaining args
+	MOVQ	CX, R12
+	SUBQ	$RegArgsN, R12
+	ADDQ	$1, R12 // make even number of words for stack alignment
+	ANDQ	$~1, R12
+	SHLQ	$3, R12
+	SUBQ	R12, SP
+
