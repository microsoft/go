+// mlkemEncapsulationKey is a shared helper for extracting the encapsulation key from a decapsulation key.
+func mlkemEncapsulationKey(paramSet string, seed []byte, dst []byte) {
+	alg, err := loadMLKEM()
+	if err != nil {
+		panic(err)
