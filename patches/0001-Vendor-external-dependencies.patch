+	length := blength.uint64()
+	var nx uint64
+	if len(buffer) <= 64 {
+		nx = length & 0x3f
+	} else {
+		nx = length & 0x7f
+	}
+	dst = append(dst, chain...)
+	dst = append(dst, buffer[:nx]...)
+	dst = append(dst, make([]byte, len(buffer)-int(nx))...)
+	dst = appendUint64(dst, length)
+	return dst
