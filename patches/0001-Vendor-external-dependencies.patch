+// It can't allocate Go memory nor grow the stack over the nosplit limit.
+//
+//go:nosplit
+func syscallNSystemStack(libcArgs *libcCallInfo) {
+	if libcArgs.errType != 0 {
+		libcArgs.n--
+	}
+	syscallNAsm(libcArgs)
+	if libcArgs.errType != 0 {
