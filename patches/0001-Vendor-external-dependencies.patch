+//go:linkname noescape
+//go:nosplit
+func noescape(p unsafe.Pointer) unsafe.Pointer {
+	x := uintptr(p)
+	return unsafe.Pointer(x ^ 0)
+}
+
+type libcCallInfo struct {
+	fn      uintptr
+	n       uintptr // number of parameters
+	args    uintptr // parameters
+	r1, r2  uintptr // return values
+	errType uintptr
+}
