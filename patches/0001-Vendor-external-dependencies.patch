+	_SymCryptBlobTypeMd2State        = _SymCryptBlobTypeHashState + 1
+	_SymCryptBlobTypeMd4State        = _SymCryptBlobTypeHashState + 2
+	_SymCryptBlobTypeMd5State        = _SymCryptBlobTypeHashState + 3
