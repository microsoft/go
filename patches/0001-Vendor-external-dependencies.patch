+			ossl.EVP_PKEY_free(pkey)
+		}
+		return nil, err
+	}
+	return pkey, nil
+}
+
+func checkPkey(pkey ossl.EVP_PKEY_PTR, isPrivate bool) error {
+	ctx, err := ossl.EVP_PKEY_CTX_new(pkey, nil)
+	if err != nil {
+		return err
+	}
+	defer ossl.EVP_PKEY_CTX_free(ctx)
