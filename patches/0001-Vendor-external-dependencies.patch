+	MOVW R6, R13
+	B    ret
+
+call:
+	BL (R12)
+
+ret:
+	MOVW R0, libcCallInfo_r1(R4)
+	MOVW R1, libcCallInfo_r2(R4)
+
+	MOVM.IA.W (R13), [R4-R7, R14]
+	RET
