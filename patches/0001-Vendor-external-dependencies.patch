+func osslHashUnmarshalBinary(ctx ossl.EVP_MD_CTX_PTR, ch crypto.Hash, magic string, b []byte) error {
+	algctx := getOSSLDigetsContext(ctx)
+	if algctx == nil {
+		return errHashStateInvalid
+	}
