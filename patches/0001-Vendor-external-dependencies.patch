+	return openssl.SignRSAPKCS1v15(priv, h, hashed)
+}
+
+func verifyPKCS1v15(pub *backendPublicKey, h crypto.Hash, hashed, sig []byte) error {
+	return openssl.VerifyRSAPKCS1v15(pub, h, hashed, sig)
+}
+
