+	var blob [sizeOfPublicKeyBlobMLDSA87]byte
+	var size uint32
+	if err := bcrypt.ExportKey(hKey, 0, utf16PtrFromString(bcrypt.PQDSA_PUBLIC_BLOB), blob[:], &size, 0); err != nil {
+		return err
+	}
+	return extractPQDSAKeyBytes(dst, blob[:size])
