+	var blob [sizeOfPrivateSeedBlobMLDSA]byte
+	var size uint32
+	if err := bcrypt.ExportKey(hKey, 0, utf16PtrFromString(bcrypt.PQDSA_PRIVATE_SEED_BLOB), blob[:], &size, 0); err != nil {
+		return err
+	}
+	return extractPQDSAKeyBytes(dst, blob[:size])
