+	if libcArgs.n != 0 {
+		libcArgs.args = uintptr(noescape(unsafe.Pointer(&args[0])))
+	}
+	runtime_cgocall(syscallNSystemStackABIInternal, unsafe.Pointer(&libcArgs))
+	return libcArgs.r1, libcArgs.r2
