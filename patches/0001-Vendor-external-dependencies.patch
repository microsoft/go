+	BEQ  R4, R15, _5args
+	MOVV $6, R15
+	BEQ  R4, R15, _6args
+	MOVV $7, R15
+	BEQ  R4, R15, _7args
+	MOVV $8, R15
+	BEQ  R4, R15, _8args
