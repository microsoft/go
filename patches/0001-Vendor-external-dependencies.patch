+	hashSlice := make([]byte, h.size, 64) // explicit cap to allow stack allocation
+	cryptokit.FinalizeHMAC(h.kind, h.ptr, hashSlice)
+	runtime.KeepAlive(h)
+
+	b = append(b, hashSlice...)
+
+	return b
+}
