+	MOVD (7*8)(R12), R7
+
+_7args:
+	MOVD (6*8)(R12), R6
+
+_6args:
+	MOVD (5*8)(R12), R5
+
+_5args:
+	MOVD (4*8)(R12), R4
+
+_4args:
+	MOVD (3*8)(R12), R3
+
+_3args:
+	MOVD (2*8)(R12), R2
+
+_2args:
