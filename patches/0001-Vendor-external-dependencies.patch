+	if err := setString(bcrypt.HANDLE(hKey), bcrypt.PARAMETER_SET_NAME, paramSet); err != nil {
+		return err
+	}
+
+	err = bcrypt.FinalizeKeyPair(hKey, 0)
+	if err != nil {
+		return err
+	}
