+
+var errHashStateInvalid = errors.New("openssl: can't retrieve hash state")
+
+func osslHashAppendBinary(ctx ossl.EVP_MD_CTX_PTR, ch crypto.Hash, magic string, buf []byte) ([]byte, error) {
