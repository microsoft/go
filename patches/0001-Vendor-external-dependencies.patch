+	ADD  $1, R3
+	MOVD $~1, R4
+	AND  R4, R3
+	SLD  $3, R3
+	ADD  $96, R3
+	NEG  R3, R4
+	ADD  R4, R24, R1
+	MOVD $~15, R3
