+	// in a EVP_MD_CTX, e.g. MD5 in FIPS mode. We need to prove
+	// if they can be used by passing them to a EVP_MD_CTX.
+	var supported bool
+	if ctx, _ := ossl.EVP_MD_CTX_new(); ctx != nil {
+		_, err := ossl.EVP_DigestInit_ex(ctx, alg.md, nil)
+		supported = err == nil
