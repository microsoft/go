+	CMP R28, $0; BEQ _0args
+	CMP R28, $1; BEQ _1args
+	CMP R28, $2; BEQ _2args
+	CMP R28, $3; BEQ _3args
+	CMP R28, $4; BEQ _4args
+	CMP R28, $5; BEQ _5args
+	CMP R28, $6; BEQ _6args
+	CMP R28, $7; BEQ _7args
+
