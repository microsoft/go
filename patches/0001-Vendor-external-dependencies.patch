+
+	runtime.KeepAlive(h)
+
+	runtime.SetFinalizer(hmac, func(h *cryptoKitHMAC) {
+		cryptokit.FreeHMAC(h.kind, h.ptr)
+	})
+
+	return hmac, nil
+}
