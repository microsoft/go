+	MOVD (7*8)(R26), R10
+
+_7args:
+	MOVD (6*8)(R26), R9
+
+_6args:
+	MOVD (5*8)(R26), R8
+
+_5args:
+	MOVD (4*8)(R26), R7
+
+_4args:
+	MOVD (3*8)(R26), R6
+
+_3args:
+	MOVD (2*8)(R26), R5
+
+_2args:
+	MOVD (1*8)(R26), R4
+
+_1args:
+	MOVD (0*8)(R26), R3
+
+_0args:
+	// ELFv2: function address in R12 and CTR
+	MOVD R27, R12
+	MOVD R12, CTR
+	BL   (CTR)
+
+	// Restore TOC and stack pointer
+	MOVD 24(R1), R2
+	MOVD R24, R1
+
+	// Save return values
+	MOVD R3, libcCallInfo_r1(R25)
+	MOVD R4, libcCallInfo_r2(R25)
+
+	// Restore callee-saved registers
+	MOVD 32(R1), R24
+	MOVD 40(R1), R25
+	MOVD 48(R1), R26
+	MOVD 56(R1), R27
+	MOVD 64(R1), R28
+
+	RET
