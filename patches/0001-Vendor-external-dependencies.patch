+//go:build !cmd_go_bootstrap && (cgo || goexperiment.ms_nocgo_opensslcrypto)
+
+package openssl
+
+import (
+	"hash"
+	"runtime"
+	"slices"
+	"sync"
+	"unsafe"
+
+	"github.com/golang-fips/openssl/v2/internal/ossl"
