+	MOVD  LR, R0
+	MOVD  R0, 16(R1)
+	MOVDU R1, -32(R1)
+	MOVD  R3, 32(R1)
+	CALL  ·syscallNSystemStack(SB)
+	ADD   $32, R1
+	MOVD  16(R1), R0
+	MOVD  R0, LR
+	RET
