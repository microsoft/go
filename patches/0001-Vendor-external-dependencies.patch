+	pkey := testRSAPrivateKey()
+	ctx, err := ossl.EVP_PKEY_CTX_new(pkey, nil)
+	if err != nil {
+		return false
+	}
+	defer ossl.EVP_PKEY_CTX_free(ctx)
+
+	if _, err := ossl.EVP_PKEY_encrypt_init(ctx); err != nil {
+		return false
+	}
