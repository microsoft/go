+	outLen := prevLen + needLen
+	if _, err := ossl.EVP_KDF_derive(c.ctx, base(c.buf), outLen, nil); err != nil {
+		return 0, err
+	}
+	n := copy(p, c.buf[prevLen:outLen])
+	return n, nil
+}
