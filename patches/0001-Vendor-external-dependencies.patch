+
+func mldsaSign(paramSet string, seed, message []byte, signatureSize int, context string) ([]byte, error) {
+	hKey, err := importMLDSAPrivateKey(paramSet, seed)
+	if err != nil {
+		return nil, err
+	}
+	defer bcrypt.DestroyKey(hKey)
