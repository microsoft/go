+func newEVPPKEY(key ossl.EC_KEY_PTR) (ossl.EVP_PKEY_PTR, error) {
+	pkey, err := ossl.EVP_PKEY_new()
+	if err != nil {
+		return nil, err
+	}
+	if _, err := ossl.EVP_PKEY_assign(pkey, ossl.EVP_PKEY_EC, unsafe.Pointer(key)); err != nil {
+		ossl.EVP_PKEY_free(pkey)
+		return nil, err
+	}
+	return pkey, nil
+}
