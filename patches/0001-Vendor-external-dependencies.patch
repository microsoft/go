+
+// NewMD5 returns a new MD5 hash.
+func NewMD5() hash.Hash {
+	return newHash(crypto.MD5)
+}
+
+// NewSHA1 returns a new SHA1 hash.
+func NewSHA1() hash.Hash {
+	return newHash(crypto.SHA1)
+}
+
+// NewSHA224 returns a new SHA224 hash.
