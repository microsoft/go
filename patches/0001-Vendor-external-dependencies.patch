+	switch ch {
+	case crypto.MD5:
+		d := (*_OSSL_MD5_CTX)(unsafe.Pointer(algctx))
+		return d.UnmarshalBinary(b)
+	case crypto.SHA1:
+		d := (*_OSSL_SHA_CTX)(unsafe.Pointer(algctx))
+		return d.UnmarshalBinary(b)
+	case crypto.SHA224, crypto.SHA256:
+		d := (*_OSSL_SHA256_CTX)(unsafe.Pointer(algctx))
+		return d.UnmarshalBinary(b)
