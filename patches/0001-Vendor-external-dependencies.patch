+		ctrlSlice(ossl.EVP_PKEY_CTRL_HKDF_SALT, salt) &&
+		ctrlSlice(ossl.EVP_PKEY_CTRL_HKDF_KEY, pseudorandomKey) &&
+		ctrlSlice(ossl.EVP_PKEY_CTRL_HKDF_INFO, info) {
