+		if err != nil {
+			// Zero output buffer on error.
+			for i := range out {
+				out[i] = 0
+			}
+		}
+	}()
+	if _, err := ossl.EVP_DecryptInit_ex(ctx, nil, nil, nil, base(nonce)); err != nil {
+		return nil, errOpen
+	}
+	if _, err := ossl.EVP_CIPHER_CTX_ctrl(ctx, ossl.EVP_CTRL_GCM_SET_TAG, 16, unsafe.Pointer(base(tag))); err != nil {
+		return nil, errOpen
