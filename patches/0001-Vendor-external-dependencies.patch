+	if _, err := ossl.EVP_DecryptUpdate(ctx, nil, &discard, sliceNeverNil(aad)); err != nil {
+		return nil, errOpen
+	}
+	if _, err := ossl.EVP_DecryptUpdate(ctx, out, &outl, sliceNeverNil(ciphertext)); err != nil {
+		return nil, errOpen
+	}
+	if len(ciphertext) != int(outl) {
+		return nil, errOpen
+	}
+	discard = 0
