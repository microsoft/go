+
+_stackargs:
+	SLD  $3, R3, R5
+	MOVD (R26)(R5), R6
+	SUB  $8, R3, R7
+	SLD  $3, R7
+	ADD  $96, R7
+	MOVD R6, (R1)(R7)
+	ADD  $1, R3
+	CMP  R3, R28
+	BLT  _stackargs
+	BR   _8args
+
+_allocsmall:
+	// <=8 args: allocate minimum 96-byte C frame
+	ADD  $-96, R24, R1
+	MOVD $~15, R3
+	AND  R3, R1
