+_6args:
+	MOVQ (5*8)(R10), R9
+
+_5args:
+	MOVQ (4*8)(R10), R8
+
+#endif
+_4args:
+	MOVQ (3*8)(R10), CX
+
+_3args:
+	MOVQ (2*8)(R10), DX
+
+_2args:
+	MOVQ (1*8)(R10), SI
+
+_1args:
+	MOVQ (0*8)(R10), DI
+
+_0args:
