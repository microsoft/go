+
+func cryptEVP(withKey withKeyFunc, padding int32,
+	h, mgfHash hash.Hash, label []byte, saltLen int32, ch crypto.Hash,
+	init initFunc, crypt cryptFunc, in []byte) ([]byte, error) {
