+	}
+
+	ctx, err := newCipherCtx(g.c.kind, cipherModeGCM, cipherOpNone, g.c.key, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer ossl.EVP_CIPHER_CTX_free(ctx)
+
