+	header _SYMCRYPT_BLOB_HEADER
+	chain  [20]uint8 // big endian
+	length _UINT64   // native endian
+	buffer [64]uint8
+	_      [8]uint8 // reserved
+	_      _SYMCRYPT_BLOB_TRAILER
