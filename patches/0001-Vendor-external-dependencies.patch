+	var hKey bcrypt.KEY_HANDLE
+	err = bcrypt.ImportKeyPair(alg.handle, 0, utf16PtrFromString(bcrypt.MLKEM_PRIVATE_SEED_BLOB), &hKey, blob, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer bcrypt.DestroyKey(hKey)
