+// NewDESCipher creates a new DES cipher block using the specified key (8 bytes).
+func NewDESCipher(key []byte) (cipher.Block, error) {
+	if len(key) != 8 {
+		return nil, errors.New("crypto/des: invalid key size for DES")
+	}
+
+	c := &desCipher{
