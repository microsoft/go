+
+	// Save original stack pointer
+	MOV X2, X20
+
+	// Align stack to 16 bytes for C calling convention
+	ANDI $-16, X2, X2
+
+	MOV libcCallInfo_args(X5), X30
+	MOV libcCallInfo_fn(X5), X29
+
+	// Do we have more than 8 arguments?
+	MOV libcCallInfo_n(X5), X10
+	BEQ X10, ZERO, _0args
+	MOV $1, X6
+	BEQ X10, X6, _1args
+	MOV $2, X6
+	BEQ X10, X6, _2args
+	MOV $3, X6
+	BEQ X10, X6, _3args
+	MOV $4, X6
+	BEQ X10, X6, _4args
+	MOV $5, X6
+	BEQ X10, X6, _5args
+	MOV $6, X6
+	BEQ X10, X6, _6args
+	MOV $7, X6
+	BEQ X10, X6, _7args
+	MOV $8, X6
+	BEQ X10, X6, _8args
