+	if h.ctx != 0 {
+		hashClone(h.ctx, &h2.ctx)
+		runtime.SetFinalizer(h2, (*Hash).finalize)
+	}
+	return h2, nil
+}
+
+func (h *Hash) Reset() {
+	defer runtime.KeepAlive(h)
+	if h.ctx != 0 {
