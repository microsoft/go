+	// In FIPS mode, setting the padding might succeed, but the actual encryption will fail.
+	// So we need to try to encrypt something to be sure.
+	in := []byte("test")
+	var outLen int
+	if _, err := ossl.EVP_PKEY_encrypt(ctx, nil, &outLen, in); err != nil {
+		return false
+	}
+	return true
