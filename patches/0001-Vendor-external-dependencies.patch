+uintptr_t MKCGO_STACK_PROTECT mkcgo_err_retrieve() {
+	// BIO operations using BIO_s_mem should not fail.
+	_BIO_PTR bio = _mkcgo_BIO_new(_mkcgo_BIO_s_mem(), NULL);
+	_mkcgo_ERR_print_errors(bio);
