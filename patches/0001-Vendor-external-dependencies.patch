+	MOVV (7*8)(R13), R11
+
+_7args:
+	MOVV (6*8)(R13), R10
+
+_6args:
+	MOVV (5*8)(R13), R9
+
+_5args:
+	MOVV (4*8)(R13), R8
+
+_4args:
+	MOVV (3*8)(R13), R7
+
+_3args:
+	MOVV (2*8)(R13), R6
+
+_2args:
+	MOVV (1*8)(R13), R5
+
+_1args:
+	MOVV (0*8)(R13), R4
+
+_0args:
+
+	CALL (R14)
+
+	// Restore original stack pointer
+	MOVV R23, R3
+
+	MOVV libcArgs+0(FP), R12
+	MOVV R4, libcCallInfo_r1(R12) // save r1
+	MOVV R5, libcCallInfo_r2(R12) // save r2
+
+	RET
