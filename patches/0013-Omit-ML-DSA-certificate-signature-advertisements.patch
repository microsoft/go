From: bot-for-go[bot] <199222863+bot-for-go[bot]@users.noreply.github.com>
Date: Mon, 19 Oct 2026 14:04:47 +0200
Subject: [PATCH] Omit ML-DSA certificate signature advertisements

Keep the signature_algorithms_cert extension but omit ML-DSA-44, ML-DSA-65, and ML-DSA-87 to avoid TLS-inspecting middlebox resets reported in golang/go#81199. Preserve other certificate signature algorithms, existing FIPS restrictions, ML-DSA handshake signatures, and ML-KEM key exchange.

Test serialized ClientHello and CertificateRequest messages under both TLS profiles. Keep canonical upstream advertisements for recorded reference handshakes using a test-only signature-list override, with production defaults covered separately.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/crypto/tls/common.go         |  19 +++++-
 src/crypto/tls/handshake_test.go |   6 ++
 src/crypto/tls/microsoft_test.go | 113 +++++++++++++++++++++++++++++++
 src/crypto/tls/tls_test.go       |  12 ++--
 4 files changed, 141 insertions(+), 9 deletions(-)

diff --git a/src/crypto/tls/common.go b/src/crypto/tls/common.go
index 1b701b257dc01e7a42c644538bca131895ab0c2d..551f4b6024cd7355a4d5d9cc67649d2b933d3a0b 100644
--- a/src/crypto/tls/common.go
+++ b/src/crypto/tls/common.go
@@ -1776,6 +1776,7 @@ func unexpectedMessageError(wanted, got any) error {
 }
 
 var testingOnlySupportedSignatureAlgorithms []SignatureScheme
+var testingOnlySupportedSignatureAlgorithmsCert []SignatureScheme
 
 // supportedSignatureAlgorithms returns the supported signature algorithms for
 // the given range of TLS versions, to advertise in ClientHello and
@@ -1815,8 +1816,8 @@ func isDisabledSignatureAlgorithm(version uint16, s SignatureScheme, isCert bool
 		}
 	}
 
-	// For the _cert extension we include all algorithms, including SHA-1 and
-	// PKCS#1 v1.5, because it's more likely that something on our side will be
+	// For the _cert extension we also include SHA-1 and PKCS#1 v1.5,
+	// because it's more likely that something on our side will be
 	// willing to accept a *-with-SHA1 certificate (e.g. with a custom
 	// VerifyConnection or by a direct match with the CertPool), than that the
 	// peer would have a better certificate but is just choosing not to send it.
@@ -1846,6 +1847,20 @@ func isDisabledSignatureAlgorithm(version uint16, s SignatureScheme, isCert bool
 // signatures in certificates.
 func supportedSignatureAlgorithmsCert(minVers, maxVers uint16) []SignatureScheme {
 	sigAlgs := defaultSupportedSignatureAlgorithms()
+	if testingOnlySupportedSignatureAlgorithmsCert != nil {
+		sigAlgs = slices.Clone(testingOnlySupportedSignatureAlgorithmsCert)
+	} else {
+		// Avoid ML-DSA in signature_algorithms_cert for compatibility with
+		// TLS-inspecting middleboxes. See https://go.dev/issue/81199.
+		sigAlgs = slices.DeleteFunc(sigAlgs, func(s SignatureScheme) bool {
+			switch s {
+			case MLDSA44, MLDSA65, MLDSA87:
+				return true
+			default:
+				return false
+			}
+		})
+	}
 	return slices.DeleteFunc(sigAlgs, func(s SignatureScheme) bool {
 		for v := minVers; v <= maxVers; v++ {
 			if !isDisabledSignatureAlgorithm(v, s, true) {
diff --git a/src/crypto/tls/handshake_test.go b/src/crypto/tls/handshake_test.go
