+// findmsgorevision returns the Microsoft-specific Go revision string from
+// MICROSOFT_REVISION, or empty string if the file doesn't exist.
+//
+// Enforces that the file content is a valid integer.
+func findmsgorevision() string {
+	path := pathf("%s/MICROSOFT_REVISION", goroot)
+	if isfile(path) {
+		r := chomp(readfile(path))
+		if _, err := strconv.Atoi(r); err != nil {
+			fatalf("MICROSOFT_REVISION content is not an integer: %q", r)
+		}
+		return r
+	}
+	return ""
+}
+
 // goModVersion returns the go version declared in src/go.mod. This is the
 // go version to use in the go.mod building go_bootstrap, toolchain2, and toolchain3.
